GLOBUY_APP_NAME=globuy
GLOBUY_APP_ENV=development
GLOBUY_DEBUG=true
GLOBUY_HOST=127.0.0.1
GLOBUY_PORT=8000
GLOBUY_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Kimi K2.6 使用 OpenAI 兼容接口。真实 Moonshot API Key 只填写在被 Git 忽略的 .env 中。
GLOBUY_MODEL_PROVIDER=openai-compatible
GLOBUY_LLM_MODEL=kimi-k2.6
GLOBUY_LLM_API_KEY=
# 官方文档：https://platform.kimi.com/docs/guide/kimi-k2-6-quickstart
GLOBUY_LLM_BASE_URL=https://api.moonshot.cn/v1
# Kimi 非思考模式使用厂商固定采样参数；该温度仅供其他 OpenAI 兼容模型使用。
GLOBUY_LLM_TEMPERATURE=0.3
GLOBUY_LLM_CONTEXT_WINDOW_TOKENS=262144
GLOBUY_LLM_MAX_OUTPUT_TOKENS=32768
GLOBUY_LLM_REQUEST_TIMEOUT_SECONDS=120
GLOBUY_LLM_MAX_RETRIES=1

# 独立 LLM Judge，仅评 P1/P2；不会复用主 Agent 的模型或密钥。
GLOBUY_EVAL_JUDGE_MODEL=deepseek-v4-pro
GLOBUY_EVAL_JUDGE_BASE_URL=https://api.deepseek.com
GLOBUY_EVAL_JUDGE_API_KEY=
GLOBUY_EVAL_JUDGE_TIMEOUT_SECONDS=120

GLOBUY_MAIN_AGENT_RECURSION_LIMIT=48
GLOBUY_MAIN_AGENT_TIMEOUT_SECONDS=300
GLOBUY_FORK_RECURSION_LIMIT=12
GLOBUY_FORK_TIMEOUT_SECONDS=90
GLOBUY_SUMMARY_TIMEOUT_SECONDS=60
GLOBUY_TOOL_RESULT_TOKEN_LIMIT=4000
GLOBUY_LOOP_DETECTION_WINDOW=6
GLOBUY_LOOP_REPEAT_THRESHOLD=4

# Agent 可观测旁路。默认关闭；LangFuse 凭据只写入本地 .env 或部署平台 Secret。
GLOBUY_OBSERVABILITY_PROVIDER=none
GLOBUY_LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
GLOBUY_LANGFUSE_PUBLIC_KEY=
GLOBUY_LANGFUSE_SECRET_KEY=
# none 不传输入输出；summary 只传结构摘要；full 传递经过脱敏和裁剪的数据。
GLOBUY_LANGFUSE_CAPTURE_MODE=summary
GLOBUY_LANGFUSE_SAMPLE_RATE=1.0
GLOBUY_OBSERVABILITY_HASH_SALT=
GLOBUY_OBSERVABILITY_FLUSH_TIMEOUT_SECONDS=2

GLOBUY_OUTPUT_DIR=output
GLOBUY_UPLOADED_DIR=uploaded
GLOBUY_PROMPT_FILE=app/prompt/prompts.yml
# 留空表示按模型窗口计算：75% 高水位触发，压缩目标约 50%；同时预留 32K 输出和 16K 安全空间。
GLOBUY_COMPRESSION_TOKEN_LIMIT=
GLOBUY_COMPRESSION_TRIGGER_RATIO=0.75
GLOBUY_COMPRESSION_TARGET_RATIO=0.50
GLOBUY_COMPRESSION_SAFETY_MARGIN_TOKENS=16384
GLOBUY_COMPRESSION_KEEP_RECENT=3
GLOBUY_WS_PING_INTERVAL=20
GLOBUY_SESSION_DB_PATH=output/globuy-sessions.sqlite3
# Legacy diagnostics/tests only. Production must leave this false and configure PostgreSQL.
GLOBUY_LEGACY_SQLITE_ENABLED=false
GLOBUY_ARCHIVE_PAGE_SIZE=20
GLOBUY_ARCHIVE_MAX_PAGE_SIZE=50
GLOBUY_RUN_CANCEL_GRACE_SECONDS=5
GLOBUY_EVENT_BUFFER_SIZE=2000
GLOBUY_EVENT_RETENTION_SECONDS=1800
GLOBUY_WS_SUBSCRIBER_QUEUE_SIZE=256

# PostgreSQL 17 + pgvector is the authoritative application and memory database.
GLOBUY_POSTGRES_DB=globuy
GLOBUY_POSTGRES_USER=globuy_app
GLOBUY_POSTGRES_PASSWORD=replace-with-a-random-local-password
GLOBUY_DATABASE_URL=postgresql+psycopg://globuy_app:URL_ENCODED_PASSWORD@127.0.0.1:5433/globuy
GLOBUY_DOCKER_DATABASE_URL=postgresql+psycopg://globuy_app:URL_ENCODED_PASSWORD@postgres:5432/globuy
GLOBUY_DATABASE_ECHO=false
GLOBUY_DATABASE_POOL_SIZE=10
GLOBUY_DATABASE_POOL_RECYCLE_SECONDS=1800
GLOBUY_AUTH_COOKIE_NAME=globuy_session
GLOBUY_AUTH_CSRF_COOKIE_NAME=globuy_csrf
GLOBUY_AUTH_SESSION_DAYS=30
GLOBUY_AUTH_COOKIE_SECURE=false
GLOBUY_AUTH_LOGIN_MAX_ATTEMPTS=8
GLOBUY_AUTH_LOGIN_WINDOW_SECONDS=900
GLOBUY_PRICE_REFRESH_INTERVAL_HOURS=24
GLOBUY_PRICE_REFRESH_LOCAL_HOUR=3

# 实时商品 Provider 默认关闭。只有确认计费、持久化与展示授权后才在本地 .env 启用。
GLOBUY_PRODUCT_PROVIDER=none
GLOBUY_JUSTONE_BASE_URL=https://api.justoneapi.com
GLOBUY_JUSTONE_TOKEN=
GLOBUY_PRODUCT_PROVIDER_TIMEOUT_SECONDS=12
# 商品只使用 PostgreSQL 候选集 + 请求内 FAISS（精确商品仍走确定性身份匹配）。
GLOBUY_PRODUCT_SEARCH_BACKEND=faiss
GLOBUY_FAISS_CANDIDATES_PER_PLATFORM=15
GLOBUY_ITEM_RERANK_GROUP_LIMIT=36
GLOBUY_ITEM_RERANK_TIMEOUT_SECONDS=20
GLOBUY_CATALOG_MINIMUM_TOTAL=60
GLOBUY_CATALOG_TARGET_TOTAL=100
GLOBUY_CATALOG_HARD_CAP_TOTAL=120
GLOBUY_CATALOG_MINIMUM_PER_PLATFORM=15
GLOBUY_CATALOG_MAX_SUCCESS_CALLS_PER_RUN=12
GLOBUY_CATALOG_MAX_ATTEMPTS_PER_RUN=20
GLOBUY_CATALOG_SOFT_DEADLINE_SECONDS=20
GLOBUY_CATALOG_HARD_DEADLINE_SECONDS=60
GLOBUY_CATALOG_FRESHNESS_SECONDS=86400
GLOBUY_CATALOG_SCOPE_TTL_SECONDS=2592000
GLOBUY_CATALOG_LEASE_SECONDS=120
GLOBUY_PROVIDER_MAX_CONCURRENCY=3
GLOBUY_PROVIDER_PER_PLATFORM_CONCURRENCY=1

# 阿里云 IQS UnifiedSearch。真实 API Key 只写入本地 .env，禁止提交。
GLOBUY_WEB_SEARCH_PROVIDER=iqs
GLOBUY_IQS_API_KEY=
GLOBUY_IQS_BASE_URL=https://cloud-iqs.aliyuncs.com
GLOBUY_IQS_ENGINE_TYPE=LiteAdvanced
GLOBUY_IQS_TIMEOUT_SECONDS=8
GLOBUY_IQS_MAX_RESULTS=10
GLOBUY_WEB_SEARCH_CONTENT_CHARS=1200

# BGE-small 512d 同时服务长期记忆（pgvector）与商品候选（请求内 FAISS），空间严格隔离。
# 推理统一走部署期准备的本地 ONNX INT8 产物（GLOBUY_CANDIDATE_EMBEDDING_ONNX_PATH），不在线下载/导出模型。
GLOBUY_EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
GLOBUY_EMBEDDING_MODEL_REVISION=main
GLOBUY_EMBEDDING_DEVICE=cpu
GLOBUY_EMBEDDING_DIMENSIONS=512
GLOBUY_EMBEDDING_BATCH_SIZE=16
GLOBUY_EMBEDDING_MAX_LENGTH=256

# 商品候选的请求内 FAISS 配置（独立 512 维空间，不落盘）。
GLOBUY_CANDIDATE_EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
GLOBUY_CANDIDATE_EMBEDDING_MODEL_REVISION=main
GLOBUY_CANDIDATE_EMBEDDING_DIMENSIONS=512
GLOBUY_CANDIDATE_EMBEDDING_BACKEND=auto
GLOBUY_CANDIDATE_EMBEDDING_ONNX_PATH=data/models/bge-small-zh-v1.5-onnx-int8
GLOBUY_CANDIDATE_EMBEDDING_ONNX_FILE=onnx/model_qint8_avx512_vnni.onnx
GLOBUY_CANDIDATE_EMBEDDING_BATCH_SIZE=64
GLOBUY_CANDIDATE_EMBEDDING_MAX_LENGTH=128
GLOBUY_CANDIDATE_EMBEDDING_TIMEOUT_SECONDS=2
GLOBUY_CANDIDATE_FAISS_GROUP_LIMIT=36
GLOBUY_CANDIDATE_EMBEDDING_CACHE_SIZE=10000
GLOBUY_CANDIDATE_EMBEDDING_CACHE_TTL_SECONDS=86400
GLOBUY_CANDIDATE_RRF_RANK_CONSTANT=60

# 长期记忆只使用 PostgreSQL/pgvector。
GLOBUY_MEMORY_STORE_BACKEND=pgvector
GLOBUY_MEMORY_RECALL_LIMIT=10
GLOBUY_MEMORY_RECALL_CANDIDATE_POOL=50
GLOBUY_MEMORY_PROMPT_TOKEN_LIMIT=1200
GLOBUY_MEMORY_PROCESSING_TIMEOUT_SECONDS=30
GLOBUY_MEMORY_CONSOLIDATION_RUN_THRESHOLD=10
GLOBUY_MEMORY_CONSOLIDATION_IDLE_SECONDS=900
GLOBUY_MEMORY_CONSOLIDATION_POLL_SECONDS=5
GLOBUY_MEMORY_CONSOLIDATION_LEASE_SECONDS=300
GLOBUY_MEMORY_DECAY_WINDOW_DAYS=180
GLOBUY_MEMORY_DECAY_FLOOR=0.6
GLOBUY_MEMORY_HISTORY_RETENTION_DAYS=180
GLOBUY_MEMORY_OUTBOX_MAX_ATTEMPTS=8
GLOBUY_MEMORY_OUTBOX_LEASE_SECONDS=300
# Set only for the one-way 20260901_0006 upgrade after verifying a database backup.
GLOBUY_MEMORY_MIGRATION_BACKUP_CONFIRMED=false
GLOBUY_PRODUCT_DATASET_PATH=datasets/headphones_1000/structured/itemsearch_candidates.jsonl
GLOBUY_FORK_CANDIDATE_LIMIT=10
GLOBUY_FORK_MAX_DEPTH=1
# Redis 仅用于登录失败限流，不参与商品检索或长期记忆。
GLOBUY_REDIS_URL=redis://127.0.0.1:6379/0
