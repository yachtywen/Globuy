GLOBUY_APP_NAME=globuy
GLOBUY_APP_ENV=development
GLOBUY_DEBUG=true
GLOBUY_HOST=127.0.0.1
GLOBUY_PORT=8000
GLOBUY_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# DeepSeek 使用 OpenAI 兼容接口。真实密钥只填写在被 Git 忽略的 .env 中。
GLOBUY_MODEL_PROVIDER=openai-compatible
GLOBUY_LLM_MODEL=deepseek-v4-pro
GLOBUY_LLM_API_KEY=
GLOBUY_LLM_BASE_URL=https://api.deepseek.com
GLOBUY_LLM_TEMPERATURE=0.3
GLOBUY_MAIN_AGENT_RECURSION_LIMIT=48
GLOBUY_MAIN_AGENT_TIMEOUT_SECONDS=300
GLOBUY_FORK_RECURSION_LIMIT=12
GLOBUY_FORK_TIMEOUT_SECONDS=90
GLOBUY_SUMMARY_TIMEOUT_SECONDS=60
GLOBUY_TOOL_RESULT_TOKEN_LIMIT=4000
GLOBUY_LOOP_DETECTION_WINDOW=6
GLOBUY_LOOP_REPEAT_THRESHOLD=4

GLOBUY_OUTPUT_DIR=output
GLOBUY_UPLOADED_DIR=uploaded
GLOBUY_PROMPT_FILE=app/prompt/prompts.yml
GLOBUY_COMPRESSION_TOKEN_LIMIT=12000
GLOBUY_COMPRESSION_KEEP_RECENT=3
GLOBUY_WS_PING_INTERVAL=20
GLOBUY_SESSION_DB_PATH=output/globuy-sessions.sqlite3
# Legacy diagnostics/tests only. Production must leave this false and configure PostgreSQL.
GLOBUY_LEGACY_SQLITE_ENABLED=false
GLOBUY_ARCHIVE_PAGE_SIZE=20
GLOBUY_ARCHIVE_MAX_PAGE_SIZE=50
GLOBUY_RUN_CANCEL_GRACE_SECONDS=5
GLOBUY_EVENT_BUFFER_SIZE=2000
GLOBUY_EVENT_RETENTION_SECONDS=1800
GLOBUY_WS_SUBSCRIBER_QUEUE_SIZE=256

# PostgreSQL 17 + pgvector is the authoritative application and memory database.
GLOBUY_POSTGRES_DB=globuy
GLOBUY_POSTGRES_USER=globuy_app
GLOBUY_POSTGRES_PASSWORD=replace-with-a-random-local-password
GLOBUY_DATABASE_URL=postgresql+psycopg://globuy_app:URL_ENCODED_PASSWORD@127.0.0.1:5433/globuy
GLOBUY_DOCKER_DATABASE_URL=postgresql+psycopg://globuy_app:URL_ENCODED_PASSWORD@postgres:5432/globuy
# One-shot migration command only; never print or commit the real source credential.
GLOBUY_MIGRATION_SOURCE_URL=mysql+asyncmy://globuy_app:URL_ENCODED_PASSWORD@127.0.0.1:3307/globuy?charset=utf8mb4
GLOBUY_DATABASE_ECHO=false
GLOBUY_DATABASE_POOL_SIZE=10
GLOBUY_DATABASE_POOL_RECYCLE_SECONDS=1800
GLOBUY_AUTH_COOKIE_NAME=globuy_session
GLOBUY_AUTH_CSRF_COOKIE_NAME=globuy_csrf
GLOBUY_AUTH_SESSION_DAYS=30
GLOBUY_AUTH_COOKIE_SECURE=false
GLOBUY_AUTH_LOGIN_MAX_ATTEMPTS=8
GLOBUY_AUTH_LOGIN_WINDOW_SECONDS=900
GLOBUY_PRICE_REFRESH_INTERVAL_HOURS=24
GLOBUY_PRICE_REFRESH_LOCAL_HOUR=3

# 实时商品 Provider 默认关闭。只有确认计费、持久化与展示授权后才在本地 .env 启用。
GLOBUY_PRODUCT_PROVIDER=none
GLOBUY_JUSTONE_BASE_URL=https://api.justoneapi.com
GLOBUY_JUSTONE_TOKEN=
GLOBUY_PRODUCT_PROVIDER_TIMEOUT_SECONDS=12
GLOBUY_CATALOG_MINIMUM_TOTAL=60
GLOBUY_CATALOG_TARGET_TOTAL=100
GLOBUY_CATALOG_HARD_CAP_TOTAL=120
GLOBUY_CATALOG_MINIMUM_PER_PLATFORM=15
GLOBUY_CATALOG_MAX_SUCCESS_CALLS_PER_RUN=12
GLOBUY_CATALOG_MAX_ATTEMPTS_PER_RUN=20
GLOBUY_CATALOG_SOFT_DEADLINE_SECONDS=20
GLOBUY_CATALOG_HARD_DEADLINE_SECONDS=60
GLOBUY_CATALOG_FRESHNESS_SECONDS=86400
GLOBUY_CATALOG_SCOPE_TTL_SECONDS=2592000
GLOBUY_CATALOG_LEASE_SECONDS=120
GLOBUY_PROVIDER_MAX_CONCURRENCY=3
GLOBUY_PROVIDER_PER_PLATFORM_CONCURRENCY=1
GLOBUY_PRODUCT_OUTBOX_BATCH_SIZE=100
GLOBUY_PRODUCT_OUTBOX_MAX_BYTES=1000000
GLOBUY_PRODUCT_OUTBOX_MAX_ATTEMPTS=8
GLOBUY_PRODUCT_OUTBOX_RETRY_BASE_SECONDS=2
GLOBUY_PRODUCT_OUTBOX_RETRY_MAX_SECONDS=300
GLOBUY_PRODUCT_INDEX_DELETED_RATIO_THRESHOLD=0.25
GLOBUY_PRODUCT_INDEX_DISK_PERCENT_THRESHOLD=80
GLOBUY_PRODUCT_INDEX_RETENTION_SECONDS=86400

# Tavily WebSearch。真实 API key 只写入本地 .env，禁止提交。
GLOBUY_WEB_SEARCH_PROVIDER=tavily
GLOBUY_TAVILY_API_KEY=
GLOBUY_TAVILY_BASE_URL=https://api.tavily.com
GLOBUY_TAVILY_PROJECT_ID=globuy
GLOBUY_TAVILY_SEARCH_DEPTH=basic
GLOBUY_TAVILY_TIMEOUT_SECONDS=12
GLOBUY_TAVILY_MAX_RESULTS=10
GLOBUY_WEB_SEARCH_CONTENT_CHARS=1200

# Faiss 保留为实验性 ANN 基础设施；ItemSearch 主链路使用下方 OpenSearch Hybrid 配置。
GLOBUY_ANN_BACKEND=faiss
GLOBUY_ANN_INDEX_PATH=data/item_index.faiss
GLOBUY_EMBEDDING_MODEL_NAME=BAAI/bge-m3
GLOBUY_EMBEDDING_MODEL_REVISION=main
GLOBUY_EMBEDDING_DEVICE=auto
GLOBUY_EMBEDDING_DIMENSIONS=1024
GLOBUY_EMBEDDING_BATCH_SIZE=16
GLOBUY_EMBEDDING_MAX_LENGTH=256

# Long-term memory uses PostgreSQL/pgvector; ItemSearch and CategoryInsight keep OpenSearch.
GLOBUY_MEMORY_STORE_BACKEND=pgvector
GLOBUY_MEMORY_CANDIDATE_MIN_CONFIDENCE=0.75
GLOBUY_MEMORY_CANDIDATE_TTL_DAYS=30
GLOBUY_MEMORY_PREFERENCE_HALF_LIFE_DAYS=180
GLOBUY_MEMORY_HISTORY_HALF_LIFE_DAYS=30
GLOBUY_MEMORY_PREFERENCE_ARCHIVE_DAYS=730
GLOBUY_MEMORY_HISTORY_ARCHIVE_DAYS=180
GLOBUY_OPENSEARCH_URL=http://127.0.0.1:9200
GLOBUY_OPENSEARCH_PRODUCT_INDEX=globuy-products-v2-initial
GLOBUY_OPENSEARCH_PRODUCT_INDEX_PREFIX=globuy-products-v2-
GLOBUY_OPENSEARCH_PRODUCT_ALIAS=globuy-products
GLOBUY_OPENSEARCH_PRODUCT_PIPELINE=globuy-products-rrf
GLOBUY_OPENSEARCH_TIMEOUT_SECONDS=10
GLOBUY_PRODUCT_DATASET_PATH=datasets/headphones_1000/structured/itemsearch_candidates.jsonl
GLOBUY_ITEM_SEARCH_POOL_FLOOR=60
GLOBUY_ITEM_SEARCH_POOL_MAX=150
GLOBUY_FORK_CANDIDATE_LIMIT=10
GLOBUY_FORK_MAX_DEPTH=1

# CategoryInsight 使用独立索引、Pipeline、可选本地 Reranker 和 Redis 查询缓存。
GLOBUY_CATEGORY_DATASET_PATH=datasets/headphones_1000/structured/itemsearch_candidates.jsonl
GLOBUY_CATEGORY_SOURCE_CATEGORY=耳机
GLOBUY_CATEGORY_ALIASES_PATH=app/category/category_aliases.yml
GLOBUY_CATEGORY_BUILD_OUTPUT_DIR=output/category
GLOBUY_OPENSEARCH_CATEGORY_ALIAS=globuy-category
GLOBUY_OPENSEARCH_CATEGORY_INDEX_PREFIX=globuy-category-v1
GLOBUY_OPENSEARCH_CATEGORY_PIPELINE_EXACT=globuy-category-exact-v1
GLOBUY_OPENSEARCH_CATEGORY_PIPELINE_BALANCED=globuy-category-balanced-v1
GLOBUY_OPENSEARCH_CATEGORY_PIPELINE_SEMANTIC=globuy-category-semantic-v1
GLOBUY_CATEGORY_COARSE_K=30
GLOBUY_CATEGORY_QUICK_K=8
GLOBUY_CATEGORY_DEEP_K=15
GLOBUY_CATEGORY_MIN_CONFIDENCE=0.5
GLOBUY_RERANKER_ENDPOINT=
GLOBUY_RERANKER_TIMEOUT_SECONDS=3
GLOBUY_CATEGORY_RERANKER_REQUIRED=false
GLOBUY_CATEGORY_RERANK_BYPASS_SCORE=0.5 #有疑问
GLOBUY_REDIS_URL=redis://127.0.0.1:6379/0
GLOBUY_CATEGORY_CACHE_TTL_SECONDS=3600
GLOBUY_CATEGORY_CACHE_TIMEOUT_SECONDS=0.25
